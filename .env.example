# ═══════════════════════════════════════════════════════════
# LighterBot Configuration - Production Template
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 🔐 LIGHTER PROTOCOL CREDENTIALS (REQUIRED)
# ─────────────────────────────────────────────────────────────
LIGHTER_API_URL=https://api.lighter.xyz/v1
LIGHTER_PRIVATE_KEY=0xYourPrivateKeyHere
LIGHTER_ACCOUNT_ADDRESS=0xYourAccountAddressHere
LIGHTER_TESTNET=false

# ─────────────────────────────────────────────────────────────
# 📊 TRADING CONFIGURATION
# ─────────────────────────────────────────────────────────────
SYMBOL=BTC-USD
BOT_MODE=rule_based                # rule_based, hybrid, ai
MAX_LEVERAGE=5
POSITION_SIZE_PCT=0.8              # % of balance per trade
MAX_POSITIONS=2
STOP_LOSS_PCT=5.0
TAKE_PROFIT_PCT=15.0

# ─────────────────────────────────────────────────────────────
# 🛡️ RISK MANAGEMENT
# ─────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=5.0             # Kill switch trigger
MAX_DRAWDOWN_PCT=10.0
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_SIZE_PCT=70.0

# ─────────────────────────────────────────────────────────────
# 📱 TELEGRAM NOTIFICATIONS (REQUIRED)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ─────────────────────────────────────────────────────────────
# 🗄️ DATABASE (OPTIONAL - RECOMMENDED FOR PRODUCTION)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/lighterbot

# ─────────────────────────────────────────────────────────────
# 🤖 ML CONFIGURATION
# ─────────────────────────────────────────────────────────────
ML_ENABLED=true
ML_MIN_TRADES=1000                 # Minimum trades before training
ML_AUTO_TRAIN=true
ML_RETRAIN_INTERVAL=86400          # 24 hours

# ─────────────────────────────────────────────────────────────
# 📝 LOGGING
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs

# ─────────────────────────────────────────────────────────────
# ⚙️ ADVANCED SETTINGS
# ─────────────────────────────────────────────────────────────
LOOP_INTERVAL=1.0                  # Main loop interval (seconds)
CLOSE_POSITIONS_ON_SHUTDOWN=true
