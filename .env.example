# Lighter API Configuration
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai
LIGHTER_WS_URL=wss://testnet.zklighter.elliot.ai/ws
LIGHTER_API_KEY_PRIVATE_KEY=replace_with_your_api_key_private_value
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_API_KEY_INDEX=2

# Trading Configuration
TRADING_SYMBOL=BTC-PERP
TRADING_MARKET_ID=1
MAX_POSITION_SIZE=0.001
MAX_LEVERAGE=5
MAX_DAILY_DRAWDOWN=0.05
MIN_ORDER_SIZE=0.001

# Risk Management
LIQUIDATION_THRESHOLD=0.2
MAX_OPEN_ORDERS=3
POSITION_CHECK_INTERVAL=60

# Strategy Configuration
ENABLE_MOMENTUM_STRATEGY=true
ENABLE_MEAN_REVERSION_STRATEGY=true
ENABLE_MARKET_MAKING_STRATEGY=false
ENABLE_GRID_TRADING_STRATEGY=false
ENABLE_ORDERFLOW_STRATEGY=true
ENABLE_SENTIMENT_STRATEGY=true

# API & Network Configuration
API_RETRY_LIMIT=3
API_TIMEOUT=30
API_INITIAL_DELAY=1.0
API_MAX_DELAY=30.0

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT=60
CB_HALF_OPEN_MAX_CALLS=1

# Safety
DRY_RUN=true
USE_TESTNET=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
ALERT_WEBHOOK_URL=

# Telegram Bot (for remote control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Environment
ENVIRONMENT=testnet
