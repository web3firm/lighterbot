# ═══════════════════════════════════════════════════════════════════════════════
# LighterBot Configuration - Production Template
# Copy this file to .env and configure with your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 LIGHTER PROTOCOL CREDENTIALS (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_API_PRIVATE_KEY=0xYourPrivateKeyHere
LIGHTER_API_KEY_INDEX=0
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_MARKET_ID=0                # 0=ETH-USD, 1=BTC-USD (check Lighter docs)

# For testnet, use:
# LIGHTER_API_URL=https://testnet.zklighter.elliot.ai

# ─────────────────────────────────────────────────────────────────────────────
# 📊 TRADING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
TRADING_SYMBOL=ETH-USD
BOT_MODE=rule_based                # rule_based, ml_based

# Position Sizing
POSITION_SIZE_PCT=50.0             # % of balance per trade (50% = half your balance)
MAX_LEVERAGE=5                     # Maximum leverage (1-10x)
MAX_OPEN_POSITIONS=1               # ONLY 1 position at a time (CRITICAL)

# Profit/Loss Targets
TP_PNL_PCT=15.0                    # Take profit at +15% PnL
SL_PNL_PCT=5.0                     # Stop loss at -5% PnL

# Position Cooldown (prevents rapid re-entry)
POSITION_COOLDOWN_SECONDS=30       # Wait 30s after position close before new entry

# ─────────────────────────────────────────────────────────────────────────────
# 🛡️ RISK MANAGEMENT (CRITICAL - SET CAREFULLY)
# ─────────────────────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=5.0             # Kill switch triggers at -5% daily loss
MAX_DRAWDOWN_PCT=10.0              # Kill switch at -10% from session peak
DRAWDOWN_WARNING_PCT=5.0           # Warning alert at -5% drawdown

# Trailing Stop Configuration
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ACTIVATION_PCT=7.0   # Activate trailing stop at +7% profit
TRAILING_STOP_TRAIL_PCT=2.0        # Trail 2% behind peak price
TRAILING_STOP_CALLBACK_PCT=0.5     # Update SL after 0.5% price movement

# ─────────────────────────────────────────────────────────────────────────────
# 📱 TELEGRAM NOTIFICATIONS (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Get bot token from @BotFather on Telegram
# Get chat ID by messaging @userinfobot

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ DATABASE (OPTIONAL - RECOMMENDED FOR PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/lighterbot

# For NeonDB (serverless PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/lighterbot?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 MACHINE LEARNING (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────
ML_ENABLED=false                   # Set to true to enable ML predictions
ML_MIN_TRADES=1000                 # Minimum trades before training
ML_AUTO_TRAIN=true                 # Auto-train when threshold reached
ML_RETRAIN_INTERVAL=86400          # Retrain every 24 hours (seconds)

# ─────────────────────────────────────────────────────────────────────────────
# 📝 LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE=true
LOG_DIR=logs

# ─────────────────────────────────────────────────────────────────────────────
# ⚙️ ADVANCED SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
LOOP_INTERVAL=1.0                  # Main loop interval (seconds)
CLOSE_POSITIONS_ON_SHUTDOWN=true   # Auto-close positions on bot shutdown
