# PRODUCTION CONFIGURATION EXAMPLE
# Copy this to .env and customize for production deployment

# ============================================================
# API CONFIGURATION (MAINNET)
# ============================================================
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/ws
LIGHTER_API_KEY_PRIVATE_KEY=your_api_key_private_value_here
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_API_KEY_INDEX=2

# ============================================================
# TRADING CONFIGURATION
# ============================================================
TRADING_SYMBOL=BTC-PERP
TRADING_MARKET_ID=1

# Start conservative!
MAX_POSITION_SIZE=0.003
MAX_LEVERAGE=5
MIN_ORDER_SIZE=0.001

# ============================================================
# RISK MANAGEMENT (CONSERVATIVE DEFAULTS)
# ============================================================
MAX_DAILY_DRAWDOWN=0.05          # 5% max daily loss
LIQUIDATION_THRESHOLD=0.2        # Alert at 20% from liquidation
MAX_OPEN_ORDERS=5
POSITION_CHECK_INTERVAL=60

# ============================================================
# STRATEGY CONFIGURATION
# ============================================================
# Momentum & Mean Reversion (recommended)
ENABLE_MOMENTUM_STRATEGY=true
ENABLE_MEAN_REVERSION_STRATEGY=true

# Order Flow & Sentiment (optional)
ENABLE_ORDERFLOW_STRATEGY=true
ENABLE_SENTIMENT_STRATEGY=true

# Advanced (disable until proven on testnet)
ENABLE_MARKET_MAKING_STRATEGY=false
ENABLE_GRID_TRADING_STRATEGY=false

# ============================================================
# RESILIENCE
# ============================================================
API_RETRY_LIMIT=3
API_TIMEOUT=30
API_INITIAL_DELAY=1.0
API_MAX_DELAY=30.0

CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT=60
CB_HALF_OPEN_MAX_CALLS=1

# ============================================================
# SAFETY (PRODUCTION SETTINGS)
# ============================================================
DRY_RUN=false                    # Set to true for simulation
USE_TESTNET=false                # Set to true for testnet

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
ALERT_WEBHOOK_URL=               # Optional: Discord/Slack webhook

ENVIRONMENT=mainnet
